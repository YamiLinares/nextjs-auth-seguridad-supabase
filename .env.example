# ---------------------------------------------------------------
# Copia este archivo como .env.local (nunca se sube a Git):
#   Copy-Item .env.example .env.local
# ---------------------------------------------------------------

# PÚBLICAS (pueden llegar al navegador; la seguridad la dan RLS y permisos mínimos)
# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# URL pública del sitio: se usa en los enlaces de los correos y en los metadatos
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOLO PARA PRUEBAS LOCALES (npm run test:e2e). No las configures en Vercel.
# Usuario de prueba creado y confirmado en Supabase > Authentication > Users.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# NUNCA pongas aquí la clave service_role ni una clave sb_secret_...
